# 빌드 결과 (exe 는 build\<버전>\ 에 따로 보관, 저장소에는 넣지 않는다)
build/
bin/
obj/
tmp/
*.exe
*.dll
*.pdb

# 비밀·설정 파일: 실제 비밀번호가 들어 있을 수 있다 (WorkHelper 옛 설정, 시험 설정 포함)
docs/.workhelper/
*.dat
*.key
*.pfx
*.pem
.env*

# 큰 디자인 원본·영상 (로컬에만)
*.sketch
*.mp4
docs/apple-ios-27-ui-kit_assets_*/

# 편집기·OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# 시험 기록(tools/tests 가 만든다)
docs/test-logs/

# 공개판 작업 폴더(2026-10-09 사용자: 공개판에 폴더를 만들어 관리, 공개하지 않는 것은 올리지 않는다):
# 그림 원본·영상 작업·Codex 문서·할 일 — README 말고는 모두 로컬에만
/work/**
!/work/**/
!/work/README.md

# 배포본 전용 추가 화면(설치 파일을 만드는 PC 에만 있는 폴더 — 없으면 앱은 그 화면 없이 빌드된다)
src/OneKey/Extra/
